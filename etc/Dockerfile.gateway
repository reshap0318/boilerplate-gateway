# ── serv-gateway (production) ────────────────────────────────────
# Multi-stage build: compile Go binaries, run FROM alpine (~20 MB)
# Binaries: server, genkey, migrate, worker (asynq)
# ──────────────────────────────────────────────────────────────────

FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git gcc musl-dev

WORKDIR /src

COPY serv-gateway/go.mod serv-gateway/go.sum ./
RUN go mod download

COPY serv-gateway/ .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -tags timetzdata -o /opt/server ./cmd/api
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /opt/genkey ./cmd/genkey
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -tags timetzdata -o /opt/migrate ./cmd/migration
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -tags timetzdata -o /opt/worker ./cmd/worker

# ── Runtime ───────────────────────────────────────────────────────
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /opt/server  /server
COPY --from=builder /opt/genkey  /genkey
COPY --from=builder /opt/migrate /migrate
COPY --from=builder /opt/worker  /worker
COPY etc/entrypoint-gateway.sh   /entrypoint.sh

RUN chmod +x /entrypoint.sh

WORKDIR /app
EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/server"]
