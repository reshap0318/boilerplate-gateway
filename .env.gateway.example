# ═══════════════════════════════════════════════════════════════
#  serv-gateway — Docker env. Copy to .env.gateway and adjust.
#  Host values below already point at container names (mysql, redis).
# ═══════════════════════════════════════════════════════════════

TZ=Asia/Jakarta

# Server
APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=http://localhost:8080
APP_FE_URL=http://localhost:3000

GIN_MODE=release
TRUSTED_PROXIES=
ALLOWED_ORIGINS=*

# Database (own database, shared mysql container)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=boil_gateway
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0

# JWT (RS256) — gateway is the only service that owns the signing keys
JWT_PRIVATE_KEY_PATH=storage/keys/private.pem
JWT_PUBLIC_KEY_PATH=storage/keys/public.pem
JWT_PASSPHRASE_PATH=storage/keys/passphrase
JWT_EXPIRATION=24
JWT_REFRESH_EXPIRATION=168

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Email/SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# serv-uam (internal calls: login verify, access-cache refill)
UAM_SERVICE_URL=http://uam:8080
