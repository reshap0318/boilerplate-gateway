# ═══════════════════════════════════════════════════════════════
#  api-gateway — Docker Environment
#  Copy to .env and adjust.
# ═══════════════════════════════════════════════════════════════

TZ="Asia/Jakarta"

# ── App Server ──────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=http://localhost:9011
APP_FE_URL=http://localhost:9011
GIN_MODE=release
TRUSTED_PROXIES=
ALLOWED_ORIGINS=*

# ── Database ─────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=api_gateway
DB_USERNAME=root
DB_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT (RS256) ─────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=storage/keys/private.pem
JWT_PUBLIC_KEY_PATH=storage/keys/public.pem
JWT_PASSPHRASE_PATH=storage/keys/passphrase
JWT_EXPIRATION=24
JWT_REFRESH_EXPIRATION=168

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Email/SMTP (optional — password reset) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Frontend (baked in at build time) ────────────────────────────
VITE_API_BASE_URL=/api
VITE_APP_NAME=ApiGateway
