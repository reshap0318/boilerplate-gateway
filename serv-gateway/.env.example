# Server
APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=http://localhost:8080

# Gin release, debug
GIN_MODE=release

# Trusted Proxies (comma-separated IPs, leave empty to disable)
TRUSTED_PROXIES=

# CORS Allowed Origins (comma-separated or * for all)
ALLOWED_ORIGINS=*

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0

# JWT (RS256)
JWT_PRIVATE_KEY_PATH=storage/keys/private.pem
JWT_PUBLIC_KEY_PATH=storage/keys/public.pem
JWT_PASSPHRASE_PATH=storage/keys/passphrase
JWT_EXPIRATION=24
JWT_REFRESH_EXPIRATION=168

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Route cache (Redis pub/sub sync + periodic fallback refresh) & health check job
GATEWAY_REFRESH_CHANNEL=gateway:route:refresh
GATEWAY_CACHE_REFRESH_INTERVAL_SECONDS=60
GATEWAY_HEALTHCHECK_INTERVAL_SECONDS=60

# serv-uam (internal calls: login verify, access-cache refill — see internal/pkg/httpclient)
SVC_UAM_URL=http://uam:8080
