# ═══════════════════════════════════════════════════════════════
#  serv-uam — Docker env. Copy to .env.uam and adjust.
# ═══════════════════════════════════════════════════════════════

TZ=Asia/Jakarta

APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=http://uam:8080

GIN_MODE=release
TRUSTED_PROXIES=

# Database (own database, shared mysql container)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=boil_uam
DB_USERNAME=root
DB_PASSWORD=
DB_MIGRATION_TABLE="goose_serv_a"

# Redis
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0

# uam has no signing keys of its own — verifies tokens against the
# gateway's public JWKS endpoint over the internal docker network.
GATEWAY_JWKS_URL=http://gateway:8080/.well-known/jwks.json

# Account lockout
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCK_DURATION_MINUTES=15
