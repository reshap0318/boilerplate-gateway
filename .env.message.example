# ═══════════════════════════════════════════════════════════════
#  serv-message — Docker env. Copy to .env.message and adjust.
# ═══════════════════════════════════════════════════════════════

TZ=Asia/Jakarta

APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=http://message:8080

GIN_MODE=release
TRUSTED_PROXIES=

# Database (own database, shared mysql container)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=boil_message
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0

# Verifies tokens against the gateway's public JWKS endpoint.
GATEWAY_JWKS_URL=http://gateway:8080/.well-known/jwks.json

# Email/SMTP
APP_NAME="Api Gateway"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
