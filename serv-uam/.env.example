# Server
APP_HOST=0.0.0.0
APP_PORT=8081
APP_URL=http://localhost:8081

# Gin release, debug
GIN_MODE=release

# Trusted Proxies (comma-separated IPs, leave empty to disable)
# Set this to the api-gateway's IP so X-Forwarded-For is trusted correctly.
TRUSTED_PROXIES=

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=service
DB_USERNAME=root
DB_PASSWORD=
DB_MIGRATION_TABLE="goose_serv_a"

# Redis
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0

GATEWAY_JWKS_URL=

# serv-message (internal call: 2FA code email)
SVC_MESSAGE_URL=http://message:8080

# Account lockout (see AuthVerify / registerFailedLogin)
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCK_DURATION_MINUTES=15

# 2FA (see TwoFASend / TwoFAVerify)
AUTH_2FA_OTP_TTL_MINUTES=5
AUTH_2FA_MAX_ATTEMPTS=5
